# ====================================
# LLM Provider API Keys（可选后备）
# 推荐：在「模型管理」页面按模型直接填写 API Key（存 SQLite）。
# 模型分本地/云端两类：云端配置 provider + api_base + API Key；
# 本地（Ollama / OpenAI 兼容端点如 LM Studio、vLLM）不配置 Key。
# 这里的环境变量仅作后备：云端模型 api_key 填变量名时从环境读取。
# ====================================

# 阿里云百炼（DashScope）— 主要供应商
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# ====================================
# Core Config
# ====================================

# 端口/绑定（也可用 lloom-server --web-port/--ai-port/--bind 传入，CLI 优先级更高）
#LLOOM_WEB_PORT=7861
#LLOOM_AI_PORT=7862
#LLOOM_BIND=127.0.0.1

# 数据目录
LLOOM_DATA_DIR=./data

# pinned 模式：soft（默认）= pinned 模型评分 +0.3 强先验，数据可推翻；
# hard = 旧行为，门槛内直接钦定（撤回开关，演示需要完全可控时打开）
#LLOOM_PINNED_MODE=soft

# ====================================
# Ollama Config（本地零成本兜底层）
# 模型管理选「本地模型」时可逐模型覆盖此地址；OpenAI 兼容本地服务
# （LM Studio 默认 http://localhost:1234/v1、vLLM 等）选 openai 协议填写即可。
# ====================================
OLLAMA_API_BASE=http://localhost:11434
