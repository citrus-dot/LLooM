# ====================================
# LLM Provider API Keys
# ====================================

# 阿里云百炼（DashScope）— 主要供应商
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# ====================================
# Core Config
# ====================================

# 端口/绑定（也可用 lloom-server --web-port/--ai-port/--bind 传入，CLI 优先级更高）
#LLOOM_WEB_PORT=7861
#LLOOM_AI_PORT=7862
#LLOOM_BIND=127.0.0.1

# 数据目录
LLOOM_DATA_DIR=./data

# ====================================
# Ollama Config（本地零成本兜底层）
# ====================================
OLLAMA_API_BASE=http://localhost:11434
