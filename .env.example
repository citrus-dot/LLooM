# ====================================
# LLM Provider API Keys
# 填入你自己的 Key，留空则对应模型不可用
# ====================================

# 阿里云百炼（DashScope）— 主要供应商
# 获取地址：https://bailian.console.aliyun.com/ -> API-KEY 管理
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OR_SITE_URL=
OR_APP_NAME=LiteLLM Example app
OR_API_KEY=

# Azure OpenAI
AZURE_API_BASE=
AZURE_API_VERSION=
AZURE_API_KEY=

# Cohere
COHERE_API_KEY=

# Replicate
REPLICATE_API_KEY=
REPLICATE_API_TOKEN=

# Novita AI
NOVITA_API_KEY=

# INFINITY
INFINITY_API_KEY=

# Infisical
INFISICAL_TOKEN=

# ====================================
# LiteLLM Core Config
# ====================================
LITELLM_MASTER_KEY=sk-1234
DATABASE_URL=postgresql://llmproxy:dbpassword9090@db:5432/litellm
STORE_MODEL_IN_DB=True

# ====================================
# Redis Config（路由状态 + 限流）
# 密码必须与 redis.conf 中 requirepass 一致
# ====================================
REDIS_PASSWORD=litellm_redis_2026
REDIS_URL=redis://:litellm_redis_2026@redis:6379

# ====================================
# Ollama Config（本地模型，零成本层）
# 宿主机运行 Ollama，Docker 容器通过 host.docker.internal 访问
# ====================================
OLLAMA_API_BASE=http://host.docker.internal:11434

# ====================================
# Qdrant Config（语义缓存向量库）
# ====================================
QDRANT_API_BASE=http://qdrant:6333
QDRANT_API_KEY=

# ====================================
# Grafana Config
# ====================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
